[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Projectiles"
3d_physics/layer_4="Loot"
3d_physics/layer_5="Triggers"

[network]

limits/debugger/max_chars_per_second=32768
limits/debugger/max_queued_messages=2048

[physics]

common/physics_ticks_per_second=30
3d/default_gravity=20.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
