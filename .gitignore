# Godot 4 .gitignore
# Per: https://github.com/github/gitignore/blob/main/Godot.gitignore

# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg
# We DO commit export_presets.cfg — it's the dedicated-server preset (D4)
# and the Android touch-control preset (D5). Reproducibility > convention.
# export_presets.cfg
*.translation

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System / IDE / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Build output
build/
dist/
*.apk
*.aab
*.pck
*.zip
!docs/**/*.zip

# Android signing — debug keystore is OK to commit (it's the public android-debug
# key by convention), but real release keys must never enter the repo.
release.keystore
*.jks

# Python (used for tools/*.py)
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
crash*.log

# Hermes agent working files (plans, scratch)
.hermes/

# v0.1.1 — raw asset zips, gitignored; only imported .tres/.glb/.obj are committed
assets/_downloads/
